async def err_handler(update, context):
    print(f"[error] {type(context.error).__name__}: {context.error}")
    try:
        if update and update.effective_chat and is_owner(update):
            await context.bot.send_message(
                update.effective_chat.id,
                f"⚠️ خطأ (مستمر): `{str(context.error)[:200]}`",
                parse_mode=ParseMode.MARKDOWN)
    except Exception:
        pass

