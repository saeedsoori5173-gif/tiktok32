async def proxy_task(context):
    while True:
        try:
            _, avail = proxy_pool.stats()
            if avail < MIN_PROXIES_THRESHOLD:
                cleanup_dead_proxies()
                await asyncio.to_thread(fetch_free_proxies)
        except asyncio.CancelledError:
            return
        except Exception as e:
            print(f"[proxy-task] {e}")
        try:
            await asyncio.sleep(AUTO_REFRESH_INTERVAL)
        except asyncio.CancelledError:
            return

