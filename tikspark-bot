                if not sch.get("enabled"):
                    continue
                if sch.get("start") == now and not acc.get("farming"):
                    acc["farming"] = True
                    acc["farm_task"] = asyncio.create_task(
                        farm_loop(uname, context))
                    try:
                        await context.bot.send_message(
                            STATE["chat_id"], f"⏰ بدأ: `{uname}`",
                            parse_mode=ParseMode.MARKDOWN)
                    except Exception:
                        pass
                if sch.get("stop") == now and acc.get("farming"):
                    acc["farming"] = False
                    if acc.get("farm_task"):
                        acc["farm_task"].cancel()
                        acc["farm_task"] = None
        except asyncio.CancelledError:
            return
        except Exception as e:
            print(f"[sched] {e}")
        try:
            await asyncio.sleep(60)
        except asyncio.CancelledError:
            return

async def alerts(context):
    while True:
        try:
            for uname, acc in list(STATE["accounts"].items()):
                thr = acc.get("balance_alert")
                if thr and acc.get("score", 0) >= thr:
                    try:
                        await context.bot.send_message(
                            STATE["chat_id"],
                            f"🔔 `{uname}`: {acc['score']} ≥ {thr}",
                            parse_mode=ParseMode.MARKDOWN)
                    except Exception:
                        pass
                    acc["balance_alert"] = None
                    _save()
        except asyncio.CancelledError:
            return
        except Exception as e:
            print(f"[alert] {e}")
        try:
            await asyncio.sleep(600)
        except asyncio.CancelledError:
            return

