async def farm_loop(username, context):
    acc = STATE["accounts"].get(username)
    if not acc:
        return
    chat_id = STATE.get("chat_id")
    total = good = bad = 0
    status_msg = None
    last_update = 0
    fails = 0
    pause_count = 0

    while acc.get("farming", False):
        try:
            if acc.get("_needs_relogin"):
                if not await try_relogin(username):
                    await asyncio.sleep(60)
                    continue

            if pause_count >= 20:
                await asyncio.sleep(random.randint(30, 60))
                pause_count = 0

            payload = {"operationName": "GetOrders", "variables": {},
                       "query": "query GetOrders { getOrders { _id status } }"}
            _, res = await asyncio.to_thread(
                send_with_retry, acc["token"], acc["csrf"],
                payload, "GetOrders", True, acc)

            if not res or "data" not in res:
                fails += 1
                await asyncio.sleep(min(5 * fails, 60))
                continue
            fails = 0
            orders = res.get("data", {}).get("getOrders", []) or []
            pending = [o["_id"] for o in orders if o.get("status") == "pending"]
            if not pending:
                await asyncio.sleep(10)
                continue

            for task_id in pending:
                if not acc.get("farming", False):
                    break
                try:
                    rn = random.randint(3000, 4500)
                    ap = {
                        "operationName": "ActionOrder",
                        "variables": {
                            "orderId": task_id,
                            "validationData": {
                                "attempts": 1,
                                "initialNumber": float(rn),
                                "timeSpent": float(random.randint(4000, 7000)),
                                "actualCount": rn + 1,
                                "source": "CLIENT_CRONET"
                            }
                        },
                        "query": "mutation ActionOrder($orderId: ID!, $validationData: ValidationDataInput!) { actionOrder(orderId: $orderId, validationData: $validationData) { score } }",
                    }
                    _, ar = await asyncio.to_thread(
                        send_with_retry, acc["token"], acc["csrf"],
                        ap, "ActionOrder", True, acc)
                    total += 1
                    pause_count += 1
                    _record(acc, "tasks")
                    if ar and "data" in ar:
                        try:
                            sc = int(ar.get("data", {}).get("actionOrder", {}).get("score", 0))
                            good += sc
                            _record(acc, "good", sc)
                        except Exception:
                            pass
                    else:
                        bad += 1
                        _record(acc, "bad")
                except Exception as e:
                    print(f"[farm] {e}")
                    bad += 1

                if total - last_update >= 5:
                    last_update = total
                    p = acc.get("proxy")
                    pm = f"🌐 {p.url[:40]}" if p else "⚠️"
                    txt = (f"💰 *تجميع `{username}`*\n\n"
                           f"📊 {total}\n✅ {good}\n❌ {bad}\n{pm}")
                    try:
                        if status_msg:
                            await status_msg.edit_text(txt, parse_mode=ParseMode.MARKDOWN)
                        else:
                            status_msg = await context.bot.send_message(
                                chat_id, txt, parse_mode=ParseMode.MARKDOWN)
                    except Exception:
                        pass
                await asyncio.sleep(max(0.5, random.gauss(2.2, 0.6)))

        except asyncio.CancelledError:
            break
        except Exception as e:
            print(f"[farm] loop: {e}")
            await asyncio.sleep(5)

    final = f"🛑 *توقف `{username}`*\n\n📊 {total} | ✅ {good} | ❌ {bad}"
    try:
        if status_msg:
            await status_msg.edit_text(final, parse_mode=ParseMode.MARKDOWN)
        else:
            await context.bot.send_message(chat_id, final, parse_mode=ParseMode.MARKDOWN)
    except Exception:
        pass
    _save()

