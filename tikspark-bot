# APP RUNNER
# =====================================================
async def post_init(app):
    app.create_task(proxy_task(app))
    app.create_task(watchdog(app))
    app.create_task(scheduler(app))
    app.create_task(alerts(app))
    print(f"✅ بوت المالك {OWNER_ID} شغال")

def run_once():
    app = (Application.builder().token(BOT_TOKEN)
           .connect_timeout(15)
           .read_timeout(30)
           .write_timeout(30)
           .pool_timeout(10)
           .get_updates_connect_timeout(15)
           .get_updates_read_timeout(30)
           .build())
    app.add_handler(CommandHandler("start", start_cmd))
    app.add_handler(CommandHandler("menu", start_cmd))
    app.add_handler(CommandHandler("logout", logout_cmd))
    app.add_handler(CommandHandler("id", id_cmd))
    app.add_handler(CallbackQueryHandler(cb))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.add_error_handler(err_handler)
    app.post_init = post_init
    app.run_polling(
        allowed_updates=Update.ALL_TYPES,
        drop_pending_updates=False,
        close_loop=False,
    )

def main():
    if OWNER_ID == 0:
        print("❌ OWNER_ID غير محدد!")
        return
    if not BOT_TOKEN or BOT_TOKEN == "ضع_التوكن_الجديد_هنا":
        print("❌ BOT_TOKEN غير محدد! ضع التوكن الجديد.")
        return

    _load()
    
    crashes = 0
    while True:
        try:
            run_once()
            crashes = 0
        except KeyboardInterrupt:
            print("👋 خروج")
            return
        except SystemExit:
            raise
        except Exception as e:
            crashes += 1
            print(f"[supervisor] 💥 #{crashes}: {e}")
            traceback.print_exc()
            if ("unauthorized" in str(e).lower()
                    or "invalid token" in str(e).lower()):
                print("❌ توكن خاطئ — انتظار 60s")
                time.sleep(60)
                continue
            time.sleep(min(5 * crashes, 60))

if __name__ == "__main__":
    def _sig(signum, frame):
        print(f"[signal] {signum}")
        raise KeyboardInterrupt
    try:
        signal.signal(signal.SIGTERM, _sig)
    except Exception:
        pass
    try:
        main()
    except KeyboardInterrupt:
        print("👋")
