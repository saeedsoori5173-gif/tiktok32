class ProxyEndpoint:
    def __init__(self, url):
        self.url = url
        self.failures = 0
        self.banned_until = None
        self.successes = 0
        self.total_time = 0.0

    def is_available(self):
        return not (self.banned_until and datetime.now(timezone.utc) < self.banned_until)

    def mark_failed(self):
        self.failures += 1
        backoff = min(60 * (2 ** max(self.failures - 1, 0)), 3600)
        if self.failures >= 5:
            backoff = 86400
        self.banned_until = datetime.now(timezone.utc) + timedelta(seconds=backoff)

    def mark_ok(self, elapsed=0.0):
        self.failures = 0
        self.banned_until = None
        self.successes += 1
        self.total_time += elapsed

    def avg_speed(self):
        return self.total_time / self.successes if self.successes else float("inf")

class ProxyPool:
    def __init__(self):
        self.proxies = []
        self._lock = threading.Lock()

    def acquire(self, exclude_urls=None):
        exclude_urls = exclude_urls or set()
        with self._lock:
            avail = [p for p in self.proxies
                     if p.is_available() and p.url not in exclude_urls]
        return min(avail, key=lambda p: p.avg_speed()) if avail else None

    def release(self, proxy):
        pass

    def stats(self):
        with self._lock:
            total = len(self.proxies)
            avail = sum(1 for p in self.proxies if p.is_available())
        return total, avail

    def add(self, url):
        with self._lock:
            if len(self.proxies) >= MAX_POOL_SIZE:
                self.proxies = [p for p in self.proxies if p.failures < 5]
                if len(self.proxies) >= MAX_POOL_SIZE:
                    return False
            if any(p.url == url for p in self.proxies):
                return False
            self.proxies.append(ProxyEndpoint(url))
            return True

proxy_pool = ProxyPool()

def make_session(proxy_url):
    s = requests.Session()
    if proxy_url:
        s.proxies = {"http": proxy_url, "https": proxy_url}
    s.trust_env = False
    return s

def _normalize_proxy(line):
    line = line.strip()
    if not line:
        return None
    if "://" in line:
        if line.startswith("socks5://"):
            return "socks5h://" + line[len("socks5://"):]
        return line
    return "http://" + line

def _download_raw():
    raw = set()

    def fetch(url):
        try:
            r = requests.get(url, timeout=15)
            r.raise_for_status()
            return [l.strip() for l in r.text.splitlines()
                    if l.strip() and not l.startswith("#")]
        except Exception as e:
            print(f"[proxy] {url}: {e}")
            return []

    with concurrent.futures.ThreadPoolExecutor(max_workers=len(FREE_PROXY_SOURCES)) as ex:
        for lines in ex.map(fetch, FREE_PROXY_SOURCES):
            raw.update(lines)
    return raw

def _validate_proxy(proxy_url):
    try:
        s = make_session(proxy_url)
        t0 = time.time()
        r = s.get(VALIDATION_TEST_URL, timeout=VALIDATION_TIMEOUT)
        el = time.time() - t0
        ok = r.status_code == 200 and r.text.strip().startswith("{")
        s.close()
        return ok, el
    except Exception:
        return False, 0.0

def fetch_free_proxies():
    print("[proxy] 🔄 جلب...")
    try:
        raw = _download_raw()
    except Exception:
        return 0
    if not raw:
        return 0
    normalized = list({n for n in (_normalize_proxy(p) for p in raw) if n})
    with proxy_pool._lock:
        existing = {p.url for p in proxy_pool.proxies}
    fresh = [p for p in normalized if p not in existing]
    if not fresh:
        return 0
    if len(fresh) > MAX_PROXIES_TO_TEST:
        fresh = random.sample(fresh, MAX_PROXIES_TO_TEST)
    added = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=VALIDATION_THREADS) as ex:
        for url, (ok, _) in zip(fresh, ex.map(_validate_proxy, fresh)):
            if ok and proxy_pool.add(url):
                added += 1
    print(f"[proxy] ✅ {added} جديد (المجموع: {len(proxy_pool.proxies)})")
    return added

def cleanup_dead_proxies():
    with proxy_pool._lock:
        before = len(proxy_pool.proxies)
        proxy_pool.proxies = [p for p in proxy_pool.proxies if p.failures < 8]
        return before - len(proxy_pool.proxies)

