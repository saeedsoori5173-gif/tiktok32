async def do_order(update, context, kind, username, link, amount_str):
    if not STATE["active"]:
        await update.message.reply_text("❌ لا حساب.")
        return
    acc = STATE["accounts"][STATE["active"]]
    try:
        amount = int(amount_str)
        if amount <= 0:
            raise ValueError
    except ValueError:
        await update.message.reply_text("❌ رقم غير صالح.")
        return
    if acc.get("score", 0) < amount:
        context.user_data["force_pending"] = {
            "kind": kind, "amount": amount,
            "username": username, "link": link
        }
        kb = InlineKeyboardMarkup([
            [InlineKeyboardButton("✅ متابعة", callback_data="force_yes")],
            [InlineKeyboardButton("❌ إلغاء", callback_data="back")]])
        await update.message.reply_text(
            f"⚠️ رصيد غير كافٍ\nالرصيد: *{acc.get('score', 0)}* | التكلفة: *{amount}*",
            reply_markup=kb, parse_mode=ParseMode.MARKDOWN)
        return
    msg = await update.message.reply_text("⏳...")
    await _exec(msg, acc, kind, amount, username, link)

async def _exec(msg, acc, kind, amount, username, link):
    payload = {
        "operationName": "CreateOrder",
        "variables": {
            "type": kind, "amount": amount,
            "tiktokerUsername": username, "videoLink": link,
            "avatar": "https://p16-common-sign.tiktokcdn.com/musically-maliva-obj/1594805258216454~tplv-tiktokx-cropcenter:720:720.webp",
            "initialCount": 0
        },
        "query": "mutation CreateOrder($type: Action!, $amount: Int!, $tiktokerUsername: String, $videoLink: String, $avatar: String, $initialCount: Int) { createOrder(orderInput: { type: $type amount: $amount tiktokerUsername: $tiktokerUsername videoLink: $videoLink avatar: $avatar initialCount: $initialCount } ) { _id type } }",
    }
    _, result = await asyncio.to_thread(
        send_with_retry, acc["token"], acc["csrf"],
        payload, "CreateOrder", True, acc)
    if (result and "errors" not in result
            and "error" not in result and "__banned__" not in result):
        await msg.edit_text(f"✅ *تم*\n\n📦 {kind}\n🔢 {amount}",
                            parse_mode=ParseMode.MARKDOWN)
    else:
        err = "فشل"
        if result and "errors" in result:
            err = result["errors"][0].get("message", err)
        elif result:
            err = result.get("error", err)
        await msg.edit_text(f"❌ {err}")

