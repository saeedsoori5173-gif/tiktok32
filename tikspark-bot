async def handle_text(update, context):
    if not is_owner(update):
        return await reject(update)
    text = update.message.text.strip()
    aw = context.user_data.get("awaiting")

    if aw == "new_account_username":
        context.user_data["tu"] = text
        context.user_data["awaiting"] = "new_account_password"
        await update.message.reply_text("🔑 كلمة المرور:",
                                        parse_mode=ParseMode.MARKDOWN)
    elif aw == "new_account_password":
        u = context.user_data.pop("tu", "")
        context.user_data["awaiting"] = None
        try:
            await update.message.delete()
        except Exception:
            pass
        await do_login(update, u, text)
    elif aw == "followers_username":
        context.user_data["fu"] = text
        context.user_data["awaiting"] = "followers_amount"
        await update.message.reply_text("🔢 العدد:")
    elif aw == "followers_amount":
        u = context.user_data.pop("fu")
        context.user_data["awaiting"] = None
        await do_order(update, context, "followers", u, None, text)
    elif aw in ("likes_link", "views_link", "comments_link"):
        context.user_data["fl"] = text
        k = aw.split("_")[0]
        context.user_data["awaiting"] = f"{k}_amount"
        await update.message.reply_text("🔢 العدد:")
    elif aw in ("likes_amount", "views_amount", "comments_amount"):
        k = aw.split("_")[0]
        link = context.user_data.pop("fl")
        context.user_data["awaiting"] = None
        await do_order(update, context, k, None, link, text)
    elif aw in ("sched_start", "sched_stop"):
        try:
            datetime.strptime(text, "%H:%M")
            acc = STATE["accounts"].get(STATE["active"])
            if acc:
                acc["schedule"]["start" if aw.endswith("start") else "stop"] = text
                _save()
            context.user_data["awaiting"] = None
            await update.message.reply_text(f"✅ {text}")
        except ValueError:
            await update.message.reply_text("❌ صيغة `HH:MM`",
                                            parse_mode=ParseMode.MARKDOWN)
    elif aw == "alert_threshold":
        try:
            v = int(text)
            if v <= 0:
                raise ValueError
            acc = STATE["accounts"].get(STATE["active"])
            if acc:
                acc["balance_alert"] = v
                _save()
            context.user_data["awaiting"] = None
            await update.message.reply_text(f"✅ تنبيه عند {v}")
        except ValueError:
            await update.message.reply_text("❌ رقم صحيح.")
    else:
        await update.message.reply_text("استخدم /start.")

