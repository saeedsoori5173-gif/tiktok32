async def do_login(update, username, password):
    msg = await update.message.reply_text(f"⏳ `{username}`...",
                                          parse_mode=ParseMode.MARKDOWN)
    proxy = proxy_pool.acquire()
    pu = proxy.url if proxy else None
    payload = {
        "operationName": "LoginAccount",
        "variables": {"data": {
            "id": "", "uniqueId": username, "nickname": "",
            "avatarMedium": "https://p16-common-sign.tiktokcdn.com/musically-maliva-obj/1594805258216454~tplv-tiktokx-cropcenter:720:720.webp",
            "followerCount": 0, "followingCount": 0, "videoCount": 0,
            "privateAccount": False, "diggCount": 0,
            "authMethod": "local", "password": password
        }},
        "query": "mutation LoginAccount($data: TiktokInfo) { loginTiktok(data: $data) { accessToken user { score username } } }",
    }
    resp, result = await asyncio.to_thread(
        sendrequest, "", "", payload, "LoginAccount", False, pu)
    if not (resp and result and "errors" not in result and "error" not in result):
        err = "فشل"
        if result and "errors" in result:
            err = result["errors"][0].get("message", err)
        elif result:
            err = result.get("error", err)
        if proxy:
            proxy.mark_failed()
        await msg.edit_text(f"❌ {err}")
        return
    if proxy:
        proxy.mark_ok()
    try:
        token = result["data"]["loginTiktok"]["accessToken"]
        user = result["data"]["loginTiktok"]["user"]
        uname = user.get("username", username)
        score = user.get("score", 0)
        csrf = resp.headers.get("x-csrf-token") or DEFAULT_CSRF
    except KeyError as e:
        await msg.edit_text(f"❌ {e}")
        return

    await msg.edit_text("⏳ التحقق...")
    ap = {
        "operationName": "AttestDevice",
        "variables": {"integrityToken": INTEGRITY_TOKEN,
                      "requestHash": REQUEST_HASH},
        "query": "mutation AttestDevice($integrityToken: String!, $requestHash: String!) { attestDevice(integrityToken: $integrityToken, requestHash: $requestHash) { ok verified } }",
    }
    _, ar = await asyncio.to_thread(
        sendrequest, token, csrf, ap, "AttestDevice", True, pu)
    if not ar or "errors" in ar:
        if proxy:
            proxy.mark_failed()
        await msg.edit_text("❌ فشل التحقق.")
        return

    was = uname in STATE["accounts"]
    old = STATE["accounts"].get(uname)
    if old and old.get("farm_task"):
        old["farming"] = False
        try:
            old["farm_task"].cancel()
        except Exception:
            pass
    acc = _acc_default()
    acc.update({"token": token, "csrf": csrf, "score": score,
                "password": password, "proxy": proxy})
    STATE["accounts"][uname] = acc
    if not STATE["active"]:
        STATE["active"] = uname
    _save()
    pm = f"\n🌐 `{proxy.url[:50]}`" if proxy else "\n⚠️ بدون بروكسي"
    await msg.edit_text(
        f"✅ *{'تحديث' if was else 'إضافة'}*\n\n"
        f"👤 `{uname}`\n⭐ {score}{pm}",
        parse_mode=ParseMode.MARKDOWN)
    await show_menu(msg)

