def getsignature(ts, nonce, payload):
    return hmac.new(secretkey, f"{ts}-{nonce}-{payload}".encode(),
                    hashlib.sha256).hexdigest()

def sendrequest(token, csrf, payload_value, operation_name,
                needs_auth=True, proxy_url=None):
    try:
        payload_str = json.dumps(payload_value, separators=(",", ":"))
        ts = str(int(time.time() * 1000))
        nonce = str(uuid.uuid4())[:16]
        sig = getsignature(ts, nonce, payload_str)
        headers = {
            "X-APOLLO-OPERATION-NAME": operation_name,
            "Accept": "multipart/mixed; deferSpec=20220824, application/json",
            "x-language": "ar",
            "x-app-name": "com.dev.vidspark",
            "x-device-info": DEFAULT_DEVINFO,
            "x-app-sig": sig,
            "x-app-ts": ts,
            "x-app-nonce": nonce,
            "Content-Type": "application/json",
            "User-Agent": random.choice(USER_AGENTS),
            "Accept-Encoding": "gzip",
        }
        if operation_name in OPERATION_IDS:
            headers["X-APOLLO-OPERATION-ID"] = OPERATION_IDS[operation_name]
        if needs_auth:
            headers["token"] = token
            headers["x-csrf-token"] = csrf
        session = make_session(proxy_url)
        try:
            r = session.post(ENDPOINT, headers=headers,
                             data=payload_str, timeout=(10, 20))
            r.raise_for_status()
            return r, r.json()
        finally:
            try:
                session.close()
            except Exception:
                pass
    except requests.exceptions.HTTPError as e:
        status = e.response.status_code if e.response is not None else None
        if status in BAN_CODES:
            return None, {"__banned__": True, "status": status,
                          "error": f"HTTP {status}"}
        return None, {"error": str(e), "status": status}
    except requests.exceptions.RequestException as e:
        return None, {"__proxy_error__": True, "error": str(e)}
    except json.JSONDecodeError:
        return None, {"error": "JSON غير صالح"}
    except Exception as e:
        return None, {"error": f"{type(e).__name__}: {e}"}

def send_with_retry(token, csrf, payload_value, operation_name,
                    needs_auth, account, max_attempts=None):
    tried = set()
    attempt = 0
    last_err = {"error": "no attempt"}
    while True:
        try:
            proxy = account.get("proxy") if account else None
            proxy_url = proxy.url if proxy else None
            resp, result = sendrequest(token, csrf, payload_value,
                                       operation_name, needs_auth, proxy_url)
            if (result and "error" not in result
                    and "__banned__" not in result
                    and "__proxy_error__" not in result):
                if proxy:
                    proxy.mark_ok()
                return resp, result
            if result and "errors" in result:
                msg = str(result.get("errors", [{}])[0].get("message", "")).lower()
                if any(k in msg for k in AUTH_FATAL):
                    if account is not None:
                        account["_needs_relogin"] = True
                    return resp, result
            if proxy:
                tried.add(proxy.url)
                proxy.mark_failed()
                if account:
                    account["proxy"] = None
            alt = proxy_pool.acquire(exclude_urls=tried)
            if alt and account:
                account["proxy"] = alt
            last_err = result or {"error": "unknown"}
            attempt += 1
            if max_attempts and attempt >= max_attempts:
                return None, last_err
            time.sleep(min(2 ** min(attempt, 4), 30))
        except Exception as e:
            print(f"[retry] {e}")
            last_err = {"error": str(e)}
            attempt += 1
            time.sleep(3)
            if max_attempts and attempt >= max_attempts:
                return None, last_err

