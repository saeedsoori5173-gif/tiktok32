async def cb(update, context):
    q = update.callback_query
    try:
        await q.answer()
    except Exception:
        pass
    if not is_owner(update):
        return await reject(update)
    data = q.data
    STATE["chat_id"] = update.effective_chat.id

    try:
        if data == "back":
            context.user_data["awaiting"] = None
            await show_menu(q, edit=True)

        elif data == "add_account":
            context.user_data["awaiting"] = "new_account_username"
            await q.edit_message_text("➕ اسم المستخدم:",
                                      reply_markup=back_kb(),
                                      parse_mode=ParseMode.MARKDOWN)

        elif data == "proxy_stats":
            total, avail = proxy_pool.stats()
            lines = [f"🌐 *البروكسيات*\n📊 {total} | ✅ {avail} | ❌ {total - avail}\n"]
            for p in proxy_pool.proxies[:10]:
                st = "✅" if p.is_available() else "❌"
                sp = f"{p.avg_speed():.1f}s" if p.successes else "?"
                lines.append(f"{st} `{p.url[:45]}` ({sp})")
            if len(proxy_pool.proxies) > 10:
                lines.append(f"... و{len(proxy_pool.proxies) - 10}")
            await q.edit_message_text("\n".join(lines),
                                      reply_markup=proxy_kb(),
                                      parse_mode=ParseMode.MARKDOWN)

        elif data == "proxy_refresh":
            await q.edit_message_text("⏳...")
            added = await asyncio.to_thread(fetch_free_proxies)
            total, avail = proxy_pool.stats()
            await q.edit_message_text(
                f"✅ أضيف {added}\n📊 {total} | ✅ {avail}",
                reply_markup=proxy_kb())

        elif data == "proxy_cleanup":
            before = len(proxy_pool.proxies)
            cleanup_dead_proxies()
            await q.edit_message_text(
                f"🧹 {before - len(proxy_pool.proxies)} حُذف",
                reply_markup=proxy_kb())

        elif data == "accounts":
            if not STATE["accounts"]:
                await q.edit_message_text("لا حسابات.", reply_markup=back_kb())
                return
            await q.edit_message_text("📋 *الحسابات*",
                                      reply_markup=accounts_kb(),
                                      parse_mode=ParseMode.MARKDOWN)

        elif data == "accounts_delete":
            await q.edit_message_text("🗑 اختر:", reply_markup=delete_kb())

        elif data.startswith("switch:"):
            u = data.split(":", 1)[1]
            if u in STATE["accounts"]:
                STATE["active"] = u
                await show_menu(q, edit=True)
            else:
                await q.answer("غير موجود", show_alert=True)

        elif data.startswith("delete:"):
            u = data.split(":", 1)[1]
            acc = STATE["accounts"].pop(u, None)
            if acc:
                acc["farming"] = False
                if acc.get("farm_task"):
                    try:
                        acc["farm_task"].cancel()
                    except Exception:
                        pass
            if STATE["active"] == u:
                STATE["active"] = next(iter(STATE["accounts"]), None)
            _save()
            if STATE["accounts"]:
                await q.edit_message_text(
                    f"✅ حُذف `{u}`",
                    reply_markup=accounts_kb(),
                    parse_mode=ParseMode.MARKDOWN)
            else:
                await show_menu(q, edit=True)

        elif data == "farm":
            if not STATE["active"]:
                await q.answer("أضف حساباً", show_alert=True)
                return
            active = STATE["accounts"][STATE["active"]].get("farming", False)
            await q.edit_message_text(
                f"💰 *تجميع `{STATE['active']}`*\n"
                f"{'🟢 يعمل' if active else '🔴 متوقف'}",
                reply_markup=farm_kb(active),
                parse_mode=ParseMode.MARKDOWN)

        elif data == "farm_start":
            acc = STATE["accounts"].get(STATE["active"])
            if not acc or acc.get("farming"):
                await q.answer("مشغول", show_alert=True)
                return
            acc["farming"] = True
            acc["farm_task"] = asyncio.create_task(
                farm_loop(STATE["active"], context))
            await q.edit_message_text("▶️ بدأ", reply_markup=farm_kb(True))

        elif data == "farm_stop":
            acc = STATE["accounts"].get(STATE["active"])
            if acc:
                acc["farming"] = False
                if acc.get("farm_task"):
                    acc["farm_task"].cancel()
                    acc["farm_task"] = None
            await q.edit_message_text("🛑 توقف", reply_markup=farm_kb(False))

        elif data == "farm_all":
            n = len(STATE["accounts"])
            run = sum(1 for a in STATE["accounts"].values() if a.get("farming"))
            await q.edit_message_text(
                f"🔥 *الكل*\n📋 {n} | 🟢 {run} | 🔴 {n - run}",
                reply_markup=all_kb(),
                parse_mode=ParseMode.MARKDOWN)

        elif data == "farm_start_all":
            c = 0
