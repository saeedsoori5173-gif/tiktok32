                [InlineKeyboardButton("🔙 رجوع", callback_data="back")]])
            txt = (f"🔔 *التنبيه*\nالحالي: `{cur or 'لا شيء'}`\n\n"
                   f"أرسل رقماً لتعيينه.")
            context.user_data["awaiting"] = "alert_threshold"
            await q.edit_message_text(txt, reply_markup=kb,
                                      parse_mode=ParseMode.MARKDOWN)

        elif data == "alert_clear":
            acc = STATE["accounts"].get(STATE["active"])
            if acc:
                acc["balance_alert"] = None
                _save()
            await q.edit_message_text("✅ أُلغي", reply_markup=back_kb())

        elif data == "stats":
            acc = STATE["accounts"].get(STATE["active"])
            if not acc:
                await q.answer("لا حساب", show_alert=True)
                return
            if not HAS_MPL:
                stats = acc.get("stats", {})
                lines = ["📊 *إحصائيات*"]
                for d, s in list(stats.items())[-7:]:
                    lines.append(
                        f"{d}: 📋{s.get('tasks', 0)} "
                        f"✅{s.get('good', 0)} ❌{s.get('bad', 0)}")
                await q.edit_message_text("\n".join(lines) or "لا بيانات",
                                          reply_markup=back_kb(),
                                          parse_mode=ParseMode.MARKDOWN)
                return
            stats = acc.get("stats", {})
            if not stats:
                await q.edit_message_text("لا بيانات", reply_markup=back_kb())
                return
            days = sorted(stats.keys())[-14:]
            tasks = [stats[d].get("tasks", 0) for d in days]
            good = [stats[d].get("good", 0) for d in days]
            fig, ax = plt.subplots(figsize=(8, 4))
            ax.bar(days, tasks, label="Tasks", color="#3b82f6", alpha=0.7)
            ax2 = ax.twinx()
            ax2.plot(days, good, label="Score", color="#22c55e", marker="o")
            ax.set_title(f"Statistics — {STATE['active']}")
            ax.tick_params(axis="x", rotation=45)
            ax.legend(loc="upper left")
            ax2.legend(loc="upper right")
            buf = io.BytesIO()
            plt.tight_layout()
            plt.savefig(buf, format="png", dpi=100)
            plt.close()
            buf.seek(0)
            try:
                await q.message.reply_photo(photo=buf)
            except Exception:
                pass

        elif data in ("followers", "likes", "views", "comments"):
            if not STATE["active"]:
                await q.answer("أضف حساباً", show_alert=True)
                return
            if data == "followers":
                context.user_data["awaiting"] = "followers_username"
                await q.edit_message_text("👥 يوزر تيك توك:",
                                          reply_markup=back_kb())
            else:
                context.user_data["awaiting"] = f"{data}_link"
                await q.edit_message_text("🔗 الرابط:",
                                          reply_markup=back_kb())

        elif data == "force_yes":
            pending = context.user_data.pop("force_pending", None)
            if pending:
                acc = STATE["accounts"].get(STATE["active"])
                if acc:
                    await q.edit_message_text("⏳...")
                    await _exec(q, acc, pending["kind"], pending["amount"],
                                pending["username"], pending["link"])
    except Exception as e:
        print(f"[cb] {e}")
        traceback.print_exc()

